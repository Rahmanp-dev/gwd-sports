{
  "name": "ts-express-backend",
  "version": "1.0.0",
  "description": "A robust production-ready backend using TypeScript, Node.js, and Express.js.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsup src --format esm --out-dir dist --clean",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "helmet": "^6.0.1",
    "mongodb": "^6.18.0",
    "mongoose": "^8.17.0",
    "winston": "^3.8.2",
    "zod": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^24.1.0",
    "jest": "^29.0.3",
    "nodemon": "^3.1.10",
    "tsup": "^8.5.0",
    "tsx": "^4.20.2",
    "typescript": "^5.0.4"
  },

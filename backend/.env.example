# Database Configuration
DB_URI="mongodb://localhost:27017/mastergrade"

# JWT Authentication
JWT_SECRET="your_jwt_access_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here_gg"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15*60*1000
RATE_LIMIT_MAX_REQUESTS=100
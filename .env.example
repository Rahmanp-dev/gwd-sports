# Database
MONGODB_URI=mongodb://localhost:27017/gwd-sports

# JWT (min 32 characters)
JWT_SECRET=your-32-char-minimum-secret-key-here
JWT_REFRESH_SECRET=your-32-char-minimum-refresh-secret-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_NAME="GWD Sports Ecosystem"
NEXT_PUBLIC_BRAND_NAME="GWD Sports Ecosystem"

# ==========================================
# PRODUCTION SERVICES (Leave blank to disable)
# ==========================================

# Razorpay (Payments & Subscriptions)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# REQUIRED IN PRODUCTION. Without it every Razorpay webhook is rejected, which
# means a payment is only recorded if the parent's browser makes it back to the
# site after checkout. Copy it from Razorpay Dashboard → Settings → Webhooks.
# Point the webhook at /api/payments/webhook and subscribe to:
#   payment.captured, payment.failed, order.paid, refund.created,
#   refund.processed, subscription.charged, subscription.activated,
#   subscription.authenticated, subscription.halted, subscription.cancelled,
#   subscription.paused, subscription.completed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID_MONTHLY=plan_xxx
RAZORPAY_PLAN_ID_QUARTERLY=plan_xxx
RAZORPAY_PLAN_ID_YEARLY=plan_xxx

# Fee split rates in basis points. See src/lib/payments/money.ts.
# GWD_GATEWAY_RATE_BPS: 236 = 2.36% (Razorpay 2% + 18% GST), assuming GWD does
#   NOT reclaim that GST as input tax credit. If GWD is GST-registered and does
#   reclaim it, set 200 — this materially changes net margin per transaction.
# GWD_MARGIN_RATE_BPS: platform default; an academy's platformFeePercent wins.
GWD_GATEWAY_RATE_BPS=236
GWD_MARGIN_RATE_BPS=100

# OpenAI — register-photo OCR for bulk student import (Phase 1).
# Without this key the OCR import pathway is disabled; CSV and WhatsApp-text
# import still work.
OPENAI_API_KEY=sk-xxx
OPENAI_VISION_MODEL=gpt-4o

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (Emails)
RESEND_API_KEY=re_xxxx
FROM_EMAIL=noreply@gwd.in

# MSG91 (SMS) — fallback when a WhatsApp message fails to deliver.
# Indian transactional SMS also requires a DLT-registered template; without
# MSG91_TEMPLATE_ID_GENERIC the fallback is recorded as 'skipped', not sent.
MSG91_API_KEY=your_key
MSG91_TEMPLATE_ID_GENERIC=

# ==========================================
# WHATSAPP (Meta Cloud API, direct — no BSP reseller)
# ==========================================
# Leave any of these blank to run the messaging engine in no-op mode:
# everything queues and schedules normally, sends are recorded as 'skipped'
# with a reason, never as a failure.

# System User token from Business Settings — NOT the 24-hour token shown on
# the App Dashboard's getting-started panel, which expires and must not be
# used in production.
META_WHATSAPP_ACCESS_TOKEN=

# The numeric id of the SENDING NUMBER, not the phone number itself and not
# the WhatsApp Business Account id.
META_WHATSAPP_PHONE_NUMBER_ID=

# A string you invent; Meta echoes it back once during webhook setup at
#   https://your-domain/api/webhooks/meta
# to prove you own the endpoint.
META_WHATSAPP_VERIFY_TOKEN=

# Signs every webhook delivery (X-Hub-Signature-256) — this verifies the
# PAYLOAD, so unlike a shared-token scheme the webhook URL itself is not a
# credential.
META_APP_SECRET=

# Optional. When set, a copy of every real parent-facing WhatsApp message is
# also queued to this number — exactly what a parent received, verbatim —
# so you can confirm automation is actually sending while a new academy is
# being onboarded. Owner-to-owner alerts (gwd_owner_*) are never mirrored.
# Unset it once you trust the pipeline; it is not meant to stay on forever.
PLATFORM_OWNER_WHATSAPP_PHONE=

# ------------------------------------------
# BEFORE ANY MESSAGE CAN BE DELIVERED, these templates must be submitted
# through WhatsApp Manager and APPROVED BY META. Exact body text to submit is
# in the comments in src/lib/messaging/templates.ts, or run
# requiredTemplateNames() from that file for the authoritative list.
#   gwd_welcome_v1
#   gwd_attendance_confirmation_v1
#   gwd_weekly_digest_v1
#   gwd_fee_reminder_v1          (serves T-5, due date and T+3)
#   gwd_achievement_v1
#   gwd_broadcast_v1
#   gwd_payment_receipt_v1
#   gwd_owner_new_student_v1    (to the academy owner, not the parent)
#   gwd_owner_payment_v1        (to the academy owner, not the parent)
# ------------------------------------------

# ==========================================
# SCHEDULED JOBS
# ==========================================
# Authenticates /api/jobs/tick. REQUIRED IN PRODUCTION — without it the endpoint
# refuses to run, because otherwise anyone could trigger message sends.
# Call it every 15 minutes:
#   curl -X POST https://your-domain/api/jobs/tick \
#        -H "Authorization: Bearer $CRON_SECRET"
# Vercel Cron is detected automatically via its x-vercel-cron header.
CRON_SECRET=

# Messaging frequency cap and quiet hours (see src/lib/messaging/scheduling.ts).
# GWD_DAILY_MESSAGE_BUDGET: shared daily cap per parent, all message types.
# GWD_PAYMENT_MESSAGE_RESERVE: extra slots only fee reminders may use, so they
#   cannot be starved by attendance traffic sent earlier the same day.
GWD_DAILY_MESSAGE_BUDGET=3
GWD_PAYMENT_MESSAGE_RESERVE=1
GWD_QUIET_START_HOUR=21
GWD_QUIET_END_HOUR=8
GWD_PREFERRED_SEND_HOUR=10
GWD_TZ_OFFSET_MINUTES=330

# Sentry (Error Tracking)
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

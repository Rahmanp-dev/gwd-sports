# Database
MONGODB_URI=mongodb://localhost:27017/gwd-sports

# JWT (min 32 characters)
JWT_SECRET=your-32-char-minimum-secret-key-here
JWT_REFRESH_SECRET=your-32-char-minimum-refresh-secret-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_NAME="GWD Sports Ecosystem"
NEXT_PUBLIC_BRAND_NAME="GWD Sports Ecosystem"

# ==========================================
# PRODUCTION SERVICES (Leave blank to disable)
# ==========================================

# Razorpay (Payments & Subscriptions)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# REQUIRED IN PRODUCTION. Without it every Razorpay webhook is rejected, which
# means a payment is only recorded if the parent's browser makes it back to the
# site after checkout. Copy it from Razorpay Dashboard → Settings → Webhooks.
# Point the webhook at /api/payments/webhook and subscribe to:
#   payment.captured, payment.failed, order.paid, refund.created,
#   refund.processed, subscription.charged, subscription.activated,
#   subscription.authenticated, subscription.halted, subscription.cancelled,
#   subscription.paused, subscription.completed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID_MONTHLY=plan_xxx
RAZORPAY_PLAN_ID_QUARTERLY=plan_xxx
RAZORPAY_PLAN_ID_YEARLY=plan_xxx

# Fee split rates in basis points. See src/lib/payments/money.ts.
# GWD_GATEWAY_RATE_BPS: 236 = 2.36% (Razorpay 2% + 18% GST), assuming GWD does
#   NOT reclaim that GST as input tax credit. If GWD is GST-registered and does
#   reclaim it, set 200 — this materially changes net margin per transaction.
# GWD_MARGIN_RATE_BPS: platform default; an academy's platformFeePercent wins.
GWD_GATEWAY_RATE_BPS=236
GWD_MARGIN_RATE_BPS=100

# OpenAI — register-photo OCR for bulk student import (Phase 1).
# Without this key the OCR import pathway is disabled; CSV and WhatsApp-text
# import still work.
OPENAI_API_KEY=sk-xxx
OPENAI_VISION_MODEL=gpt-4o

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (Emails)
RESEND_API_KEY=re_xxxx
FROM_EMAIL=noreply@gwd.in

# MSG91 (SMS)
MSG91_API_KEY=your_key

# Sentry (Error Tracking)
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
